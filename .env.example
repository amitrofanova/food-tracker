# Copy to .env and fill in your values before running docker-compose.prod.yml
#
# DATABASE_URL is built by docker-compose.prod.yml from POSTGRES_* — do not set it here.

POSTGRES_USER=foodtracker
POSTGRES_PASSWORD=
POSTGRES_DB=food_tracker

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET=

APP_ORIGIN=https://food-tracker.135.106.167.52.sslip.io
OPENROUTER_API_KEY=
OFF_USER_AGENT=FoodTracker/1.0 (your-email)
NODE_ENV=production
PORT=3001
